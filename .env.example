# Copy this file to .env and fill in your values
# .env is gitignored — never commit real credentials

# PostgreSQL Source
SOURCE_DB_USER=sourceuser
SOURCE_DB_PASSWORD=sourcepass
SOURCE_DB_NAME=sourcedb

# PostgreSQL Destination
DEST_DB_USER=destuser
DEST_DB_PASSWORD=destpass
DEST_DB_NAME=destdb

# SeaweedFS / S3
SEAWEEDFS_ROOT_USER=seaweedadmin
SEAWEEDFS_ROOT_PASSWORD=seaweedadmin

# Airflow admin UI
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Grafana admin UI
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Read-only warehouse role used by the AI dashboard
DASHBOARD_DB_USER=dashboard_ro
DASHBOARD_DB_PASSWORD=dashboard_ro

# The same idea on the mirror. Columns classified pii or phi in the data
# contract are withheld from this role by generated grants (#231 phase 4).
DASHBOARD_CH_USER=dashboard_ro
DASHBOARD_CH_PASSWORD=dashboard_ro

# Kafka UI login
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=admin

# ClickHouse (columnar CDC mirror)
CLICKHOUSE_USER=chuser
CLICKHOUSE_PASSWORD=chpass
