# Normalize all text files to LF in the repository
* text=auto

# Files executed on Linux (containers, CI) must stay LF even in
# Windows working copies — CRLF breaks bash and postgres init scripts
*.sh text eol=lf
Makefile text eol=lf

# Source and config: LF everywhere for consistent lint results
*.py text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.ico binary
*.svg text
*.parquet binary
*.pdf binary
