# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# --- Database Connectivity ---
# Uses the read-only warehouse role created by
# docker/postgres-dest-init/01-create-dashboard-role.sh
DEST_DB_HOST=localhost
DEST_DB_PORT=5433
DEST_DB_NAME=destdb
DEST_DB_USER=dashboard_ro
DEST_DB_PASSWORD=dashboard_ro

# --- Dashboard login (HTTP Basic Auth) ---
# Leave DASHBOARD_AUTH_PASSWORD unset for open access during local dev.
# Set it on any shared deployment.
#DASHBOARD_AUTH_USER=admin
#DASHBOARD_AUTH_PASSWORD=change-me

# --- AI Data Assistant ---
# Add your Anthropic API key to enable the real AI assistant.
# Get one at: https://console.anthropic.com/
# Without it the dashboard runs in demo mode.
ANTHROPIC_API_KEY=YOUR_API_KEY_HERE
